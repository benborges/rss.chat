# Copy to .env and fill in. Only compose.prod.yml reads this.

# The domain Caddy gets a certificate for. Put the same one in config/config.prod.json.
DOMAIN=myserver.chat
ACME_EMAIL=you@example.com

# Guards https://$DOMAIN/mailpit, where the magic links arrive.
# Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
MAILPIT_USER=admin
MAILPIT_PASSWORD_HASH=
